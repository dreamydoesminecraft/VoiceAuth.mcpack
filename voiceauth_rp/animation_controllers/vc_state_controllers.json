{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.voiceauth.state": {
      "initial_state": "locked",

      "states": {
        "locked": {
          "on_entry": [
            "event=entity @s voiceauth_lock;"
          ],
          "transitions": [
            {
              "unlocked": "variable.voiceauth_is_unlocked == 1"
            }
          ]
        },

        "unlocked": {
          "on_entry": [
            "event=entity @s voiceauth_unlock;"
          ],
          "transitions": [
            {
              "locked": "variable.voiceauth_is_unlocked == 0"
            }
          ]
        }
      }
    }
  }
}
